# Copia este archivo como backend\.env y llena los valores. backend\.env NUNCA se sube a Git.

# --- Base de datos local (SQL Server con autenticación de Windows) ---
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=ScribeTracker
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Solo para Azure SQL (autenticación de SQL). Si se dejan vacíos se usa la de Windows ---
# DB_USER=
# DB_PASSWORD=

# Clave para firmar la cookie de sesión (genera una propia, no la compartas)
SECRET_KEY=

# --- Correo para enviar contraseñas temporales (opcional) ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
